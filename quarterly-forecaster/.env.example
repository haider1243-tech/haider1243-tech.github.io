# Copy to .env and fill in. .env is gitignored — never commit real keys.
# FRED: free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub: free tier key at https://finnhub.io/register
FINNHUB_API_KEY=
# Optional overrides
# FORECASTER_CACHE_DIR=data
# FORECASTER_CACHE_TTL_HOURS=24

# Webhook server (python -m forecaster.webhook_server)
# Long random string; paste the same value into the TradingView alert JSON "secret".
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Telegram: create a bot with @BotFather (token), send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: only accept requests from these IPs. TradingView publishes its webhook IPs in its
# help centre ("About webhooks"); verify the current list there before enabling.
# WEBHOOK_ALLOWED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
