# Copy to .env and fill in. .env is gitignored — never commit real keys.
# FRED: free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub: free tier key at https://finnhub.io/register
FINNHUB_API_KEY=
# Optional overrides
# FORECASTER_CACHE_DIR=data
# FORECASTER_CACHE_TTL_HOURS=24

# Webhook server (python -m forecaster.webhook_server)
# Long random string; paste the same value into the TradingView alert JSON "secret".
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Telegram: create a bot with @BotFather (token), send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: only accept requests from these IPs. TradingView publishes its webhook IPs in its
# help centre ("About webhooks"); verify the current list there before enabling.
# WEBHOOK_ALLOWED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# OANDA: live prices for the app's Live tab + webhook gold check (read-only), and execution
# (python -m forecaster.execution). PRACTICE account by default.
# Practice token: OANDA hub -> "Manage API Access" on your demo (fxTrade Practice) account.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice (default) | live. "live" is refused unless LIVE_TRADING=true is also in THIS file.
OANDA_ENVIRONMENT=practice
# Do not add LIVE_TRADING=true unless you have decided to trade real money.
# LIVE_TRADING=true
# Orders are only placed when this is true (even on practice).
EXECUTION_ENABLED=false
RISK_PER_TRADE_PCT=0.5        # hard ceiling 2%
MAX_POSITION_UNITS=10         # XAU_USD units (1 unit = 1 oz); counts the existing position
MAX_DAILY_LOSS=100            # account currency, NAV change since 17:00 New York
MAX_OPEN_TRADES=1
MAX_ALERT_AGE_SECONDS=120
MAX_PRICE_DEVIATION=0.005     # alert price vs OANDA mid
# OANDA_MT4_ACCOUNT=true      # set if the account is linked to MT4 (no client extensions)
# KILL_SWITCH=true            # blocks all orders (or: python -m forecaster.execution --kill)

# Dashboard password (required: the app shows nothing without it).
# Create with: python -m forecaster.auth   (stores a PBKDF2 hash, never the password)
APP_PASSWORD_HASH=
# Webhook rate limits (requests per minute)
WEBHOOK_RATE_PER_IP=30
WEBHOOK_RATE_TOTAL=120
